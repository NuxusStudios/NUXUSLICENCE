{
  "expo": {
    "name": "CivicPass",
    "slug": "civicpass",
    "scheme": "civicpass",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ca.example.civicpass",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your digital wallet.",
        "NSCameraUsageDescription": "The camera is used to scan identity documents and verify QR codes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ca.example.civicpass",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      ["expo-local-authentication", { "faceIDPermission": "Use Face ID to unlock your digital wallet." }],
      ["expo-camera", { "cameraPermission": "The camera is used to scan identity documents and verify QR codes.", "recordAudioAndroid": false }],
      ["expo-notifications", { "color": "#0B4F8A" }]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {}
    }
  }
}
